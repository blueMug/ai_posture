.page {
  min-height: 100vh;
  padding: 88rpx 28rpx 150rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 22% 8%, rgba(255, 233, 92, 0.20), transparent 34%),
    radial-gradient(circle at 86% 18%, rgba(156, 231, 255, 0.14), transparent 36%),
    linear-gradient(180deg, #171717 0%, #090909 100%);
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
}

.back-btn,
.placeholder {
  width: 108rpx;
}

.back-btn {
  color: rgba(255, 255, 255, 0.86);
  font-size: 26rpx;
}

.title {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
}

.hero-card {
  margin-top: 26rpx;
  padding: 30rpx;
  border-radius: 38rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 88% 20%, rgba(255, 233, 92, 0.26), transparent 34%),
    linear-gradient(135deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.08));
  border: 1rpx solid rgba(255, 255, 255, 0.22);
}

.hero-kicker {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #111111;
  font-size: 22rpx;
  font-weight: 900;
  background: #ffe95c;
}

.hero-title {
  margin-top: 18rpx;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 900;
}

.hero-subtitle {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 25rpx;
  line-height: 1.45;
}

.topic-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.topic-card {
  position: relative;
  min-height: 246rpx;
  padding: 24rpx 110rpx 24rpx 22rpx;
  border-radius: 30rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.11);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.topic-copy {
  position: relative;
  z-index: 2;
}

.topic-title {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
}

.topic-desc {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 21rpx;
  line-height: 1.4;
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.topic-count {
  margin-top: 14rpx;
  color: rgba(255, 233, 92, 0.94);
  font-size: 21rpx;
  font-weight: 800;
}

.topic-image {
  position: absolute;
  right: -10rpx;
  bottom: -22rpx;
  width: 132rpx;
  height: 172rpx;
  opacity: 0.84;
  z-index: 1;
}

.topic-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
  background:
    radial-gradient(circle at 90% 92%, rgba(255, 233, 92, 0.20), transparent 42%),
    linear-gradient(135deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0.04));
}

.image-error {
  position: absolute;
  right: 10rpx;
  bottom: 44rpx;
  width: 118rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 20rpx;
  text-align: center;
  z-index: 2;
}

.empty-state {
  margin-top: 180rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 28rpx;
  text-align: center;
}
